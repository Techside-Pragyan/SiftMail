# SiftMail Backend Configuration
PROJECT_NAME="SiftMail API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="siftmail_super_secure_jwt_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/siftmail_db"
# Fallback to local SQLite if PostgreSQL is not active:
# DATABASE_URL="sqlite+aiosqlite:///./siftmail.db"

# AI / LLM Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
